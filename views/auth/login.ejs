<body class="bg-surface text-on-surface min-h-screen flex flex-col">
<!-- TopNavBar Suppression: Logic - Transactional/Login screen. 
         Manual Header for Identity -->
<header class="w-full h-20 px-container-margin flex justify-center items-center">
<div class="font-h2 text-h2 font-bold text-primary">To-Let</div>
</header>
<main class="flex-grow flex items-center justify-center px-container-margin py-xl">
<div class="w-full max-w-[440px] bg-surface-container-lowest border border-outline-variant p-xl shadow-sm">
<!-- Hero Branding/Iconography -->
<div class="flex flex-col items-center mb-xl">
<div class="w-16 h-16 bg-primary-container text-on-primary flex items-center justify-center rounded mb-md">
<span class="material-symbols-outlined !text-[32px]">domain</span>
</div>
<h1 class="font-h1 text-h1 text-primary text-center">Welcome back</h1>
<p class="font-body-sm text-body-sm text-on-surface-variant text-center mt-xs">Log in to manage your property portfolio with clarity.</p>
</div>
<!-- Login Form -->
<form action="/login" method="POST" class="space-y-lg">
  <!-- <input type="email" name="email" class="form-control mb-2" placeholder="Email" required>

  <input type="password" name="password" class="form-control mb-3" placeholder="Password" required> -->
<div class="space-y-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant block">EMAIL ADDRESS</label>
<div class="relative">
<input type="email" name="email" class="w-full px-md py-sm border border-outline text-body-base 
font-body-base bg-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container 
outline-none transition-all" placeholder="Email" required/>
</div>
</div>
<div class="space-y-xs">
<div class="flex justify-between items-end">
<label class="font-label-caps text-label-caps text-on-surface-variant block">PASSWORD</label>
<!-- <a class="font-body-xs text-body-xs text-primary-container font-semibold hover:underline" href="#">Forgot password?</a> -->
</div>
<div class="relative">
<input type="password" name="password" class="w-full px-md py-sm border border-outline text-body-base 
font-body-base bg-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container 
outline-none transition-all" placeholder="Password" required/>
</div>
</div>
