<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Rental</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

<div class="page-wrapper">
  <div class="form-card">

    <h3 class="page-title">➕ Add New Rental</h3>

    <form action="/rentals" method="POST" enctype="multipart/form-data">

      <!-- Basic Info -->
      <div class="form-section-title">Basic Information</div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label class="form-label">Property Name</label>
          <input type="text" name="name" class="form-control" required>
        </div>
        <div class="col-12 col-sm-6">
          <label class="form-label">Rent Price (৳)</label>
          <input type="number" name="rentPrice" class="form-control" required>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Address</label>
        <input type="text" name="address" class="form-control" required>
      </div>

      <hr class="section-divider">

      <!-- Features -->
      <div class="form-section-title">Property Features</div>

      <div class="features-grid">
        <input type="number" name="beds"     class="form-control" placeholder="Beds">
        <input type="number" name="baths"    class="form-control" placeholder="Baths">
        <input type="number" name="dining"   class="form-control" placeholder="Dining">
        <input type="number" name="drawing"  class="form-control" placeholder="Drawing">
        <input type="number" name="porch"    class="form-control" placeholder="Porch">
      </div>

      <div class="mb-3">
        <input type="number" name="squareFeet" class="form-control" placeholder="Square Feet">
      </div>

      <hr class="section-divider">

      <!-- Description -->
      <div class="form-section-title">Description</div>

      <div class="mb-3">
        <textarea name="description" class="form-control" rows="4"></textarea>
      </div>

      <!-- Availability -->
      <div class="mb-3">
        <label class="form-label">Available From</label>
        <input type="date" name="availableFrom" class="form-control">
      </div>

      <hr class="section-divider">

      <!-- Image -->
      <div class="form-section-title">Upload Image</div>

      <div class="mb-3">
        <input type="file" name="image" class="form-control" accept="image/*"
               onchange="previewImage(event)">
        <img id="imagePreview" class="preview-img" style="display:none;" alt="Preview">
      </div>

      <!-- Buttons -->
      <div class="action-row">
        <a href="/rentals" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Rental</button>
      </div>

    </form>

  </div>
</div>

<script>
  function previewImage(event) {
    const img = document.getElementById('imagePreview');
    const file = event.target.files[0];
    if (!file) return;
    img.src = URL.createObjectURL(file);
    img.style.display = 'block';
  }
</script>

</body>
</html>