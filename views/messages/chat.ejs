<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    html, body {
      height: 100%;
      margin: 0;
      background: #f5f7fb;
    }

    .chat-wrapper {
      display: flex;
      flex-direction: column;
      height: 100dvh; /* dynamic viewport height — accounts for mobile browser chrome */
      padding: 12px;
      box-sizing: border-box;
      max-width: 768px;
      margin: 0 auto;
    }

    .chat-box {
      flex: 1;
      overflow-y: auto;
      background: white;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      -webkit-overflow-scrolling: touch; /* smooth scroll on iOS */
    }

    .msg {
      margin-bottom: 12px;
    }

    .mine {
      text-align: right;
    }

    .bubble {
      display: inline-block;
      padding: 10px 14px;
      border-radius: 12px;
      max-width: 80%;        /* slightly wider on small screens */
      font-size: 1rem;       /* 16px — never below this on mobile to avoid auto-zoom */
      line-height: 1.45;
      word-break: break-word;
    }

    .mine .bubble {
      background: #0d6efd;
      color: white;
    }

    .other .bubble {
      background: #e9ecef;
      color: #212529;
    }

    /* Input row — always visible above keyboard */
    .chat-form .input-group {
      gap: 8px;
    }

    .chat-form .form-control {
      font-size: 1rem;       /* prevents iOS auto-zoom (needs >= 16px) */
      border-radius: 10px !important;
      padding: 12px 14px;
    }

    .chat-form .btn {
      border-radius: 10px !important;
      padding: 12px 20px;
      font-size: 1rem;
      white-space: nowrap;
    }

    /* Slightly more room on larger screens */
    @media (min-width: 576px) {
      .chat-wrapper {
        padding: 24px;
      }

      .bubble {
        max-width: 70%;
      }
    }
  </style>
</head>
<body>

<div class="chat-wrapper">

  <div class="chat-box" id="chatBox">

    <% messages.forEach(msg => { %>

      <div class="msg <%= msg.sender._id.toString() === currentUser._id ? 'mine' : 'other' %>">
        <div class="bubble">
          <%= msg.text %>
        </div>
      </div>

    <% }) %>

  </div>

  <form id="chatForm" class="chat-form">
    <div class="input-group">
      <input
        type="text"
        id="messageInput"
        class="form-control"
        placeholder="Type a message…"
        autocomplete="off"
        required
      >
      <button class="btn btn-primary">Send</button>
    </div>
  </form>

</div>

<script src="/socket.io/socket.io.js"></script>

<script>
  const socket = io();

  const currentUserId = "<%= currentUser._id %>";
  const receiverId    = "<%= receiverId %>";
  const rentalId      = "<%= rentalId %>";

  socket.emit("join", currentUserId);

  const chatBox = document.getElementById("chatBox");

  // Scroll to bottom on load
  chatBox.scrollTop = chatBox.scrollHeight;

  document.getElementById("chatForm").addEventListener("submit", (e) => {
    e.preventDefault();

    const input = document.getElementById("messageInput");

    socket.emit("sendMessage", {
      senderId: currentUserId,
      receiverId,
      rentalId,
      text: input.value
    });

    input.value = "";
    input.focus();
  });

  socket.on("receiveMessage", (msg) => {
    const div = document.createElement("div");

    div.className =
      "msg " + (msg.sender._id === currentUserId ? "mine" : "other");

    div.innerHTML = `<div class="bubble">${msg.text}</div>`;

    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
  });
</script>

</body>
</html>